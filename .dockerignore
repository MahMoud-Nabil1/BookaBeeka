# ==============================================================================
# Docker Ignore - Root Context
# BookaBeeka Multi-Module Monorepo (Backend Spring Boot + FrontEnd Vite/React)
# ==============================================================================

# Version control & Git
.git
.gitignore
.gitattributes

# IDEs, Editors & OS metadata
.idea
.vscode
*.iml
*.iws
*.ipr
.DS_Store
Thumbs.db
ehthumbs.db

# Environment variables & secrets (NEVER send to Docker daemon)
.env
*.env
.env.*
*.env.*
!*.env.example

# Temporary folders & test node_modules
_tmp_bcrypt/
**/_tmp_bcrypt/
node_modules/
**/node_modules/

# Root orphan / stray files
/package-lock.json

# Backend build outputs & caches
Backend/target/
**/target/
*.class
*.jar
*.war
*.log

# Frontend build outputs & package manager logs
FrontEnd/dist/
FrontEnd/dist-ssr/
**/dist/
**/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Developer scratch scripts, tests & HTTP debug files
*.ps1
*.http
/BookaBeeka_E2E.postman_collection.json
/test-owner-login.http
/diagnose-login.ps1
/test-password-hash.ps1
/build_collection.ps1

# Backend manual test & debug scripts (preserves src/main/resources/db/migration)
Backend/*.http
Backend/*.sql

# Project documentation & planning notes
*.md
!Backend/src/main/resources/**
