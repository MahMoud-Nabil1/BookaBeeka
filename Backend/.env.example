# Database Configuration (Neon PostgreSQL or Render PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=<username>
SPRING_DATASOURCE_PASSWORD=<password>

# Server Port (Render sets PORT automatically, e.g. 10000)
PORT=8080

# Environment / Profile
SPRING_PROFILES_ACTIVE=prod

# CORS (Frontend URL or * for all)
CORS_ALLOWED_ORIGINS=https://bookabeeka-frontend.onrender.com,http://localhost:5173

# JWT Security
JWT_SECRET_KEY=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_TIME=86400000

# Cloudinary (Media upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Mail & Notification Configuration
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
APP_MAIL_ENABLED=true

# Application Base URL (frontend link for email notifications)
APP_BASE_URL=https://bookabeeka-frontend.onrender.com